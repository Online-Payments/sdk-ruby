# Copy to .env and fill in. .env is ignored by git.
# The integration tests load .env automatically; variables that are already set in the environment take precedence.

# Required for the integration tests (they are skipped when any is missing)
ONLINEPAYMENTS_API_KEY_ID="<your-api-key-id>"
ONLINEPAYMENTS_SECRET_API_KEY="<your-secret-api-key>"
ONLINEPAYMENTS_MERCHANT_ID="<your-merchant-id>"

# Optional: the endpoint to use; defaults to https://payment.direct.ecom.preprod.worldline-solutions.com
# ONLINEPAYMENTS_API_ENDPOINT=https://payment.direct.ecom.preprod.worldline-solutions.com
